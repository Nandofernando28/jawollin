# URL del Amazon API Gateway (HTTP API) desplegado con AWS SAM en us-east-1
# Ejemplo tras ejecutar `sam deploy`:
# VITE_API_URL=https://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com/prod
VITE_API_URL=

# API Key de CARTO (https://carto.com) para tiles de alta resolucion / cuota dedicada
# Si se deja vacio, utiliza los tiles publicos gratuitos de CARTO sin key.
VITE_CARTO_API_KEY=

# Estilo de mapa de CARTO: 'dark_all' (Dark Matter / Cyberpunk) o 'voyager' (claro)
VITE_CARTO_STYLE=dark_all
